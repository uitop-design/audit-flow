# Copy to .env and adjust. The root .env is shared by Docker Compose and the API.
# These values are for local development only. Never commit real credentials.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=auditflow
POSTGRES_DB=auditflow
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auditflow:auditflow@localhost:5433/auditflow
# Comma-separated list of exact browser origins allowed to call the API. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
# Serve Swagger UI at /api/docs. Defaults to true outside production.
SWAGGER_ENABLED=true
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Tests ---
# Integration tests run against this database. Its name must end in "_test".
TEST_DATABASE_URL=postgresql://auditflow:auditflow@localhost:5433/auditflow_test
