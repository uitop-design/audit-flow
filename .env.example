# Copy to .env and adjust. The root .env is shared by Docker Compose and the API.
# These values are for local development only. Never commit real credentials.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=auditflow
POSTGRES_PASSWORD=auditflow
POSTGRES_DB=auditflow
# Host port. 5433 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=5433

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auditflow:auditflow@localhost:5433/auditflow
